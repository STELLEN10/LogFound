# AI provider selected by the server-side provider registry: gemini or openai.
AI_PROVIDER=gemini
# Optional model override. Leave blank to use the provider's safe default.
AI_MODEL=
# Google AI Studio key used by the Gemini adapter. Server-only; never expose it to the browser.
GEMINI_API_KEY=AQ.Ab8RN6ItYiKcSA5_B-X4kRqvP6ev4qIF10PXzqx3prh9hmKF0w
# Optional future provider key. Server-only; only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Optional OpenAI fallback model when AI_MODEL is blank.
OPENAI_MODEL=gpt-5.6

# Supabase public project URL. NEXT_PUBLIC_* is the existing browser-safe app convention.
NEXT_PUBLIC_SUPABASE_URL=https://aquqvsqfeprvltzbhuku.supabase.co
# Supabase publishable/anon key. Safe for the browser when protected by Supabase RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFxdXF2c3FmZXBydmx0emJodWt1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQwOTY2NTEsImV4cCI6MjA5OTY3MjY1MX0.5EH00CEsEoQKUUm0lYQem3UJpedHMqurGHID2uIesEI
# Server aliases accepted by the app when you prefer non-public names for deployment configuration.
SUPABASE_URL=https://aquqvsqfeprvltzbhuku.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFxdXF2c3FmZXBydmx0emJodWt1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQwOTY2NTEsImV4cCI6MjA5OTY3MjY1MX0.5EH00CEsEoQKUUm0lYQem3UJpedHMqurGHID2uIesEI
# Supabase service-role key for server-only encrypted GitHub token storage. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFxdXF2c3FmZXBydmx0emJodWt1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDA5NjY1MSwiZXhwIjoyMDk5NjcyNjUxfQ.fIM5CElicEfuTmNlQxaRCUls8YbCrX_uqdupDVRZoEc

# Base URL used to build the GitHub OAuth callback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GitHub OAuth application credentials. Server-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte key (base64 or hex) used to encrypt GitHub tokens at rest. Server-only.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Reserved NextAuth-compatible settings for deployments that add a NextAuth adapter.
# Logfound's current authentication runtime uses Supabase sessions and does not require these yet.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
