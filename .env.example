# Server-side Groq API key. Never expose this value to the browser.
GROQ_API_KEY=

# Logfound's sole AI runtime.
AI_PROVIDER=groq

# Public application URL and session signing secret.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth application credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase server storage used for encrypted GitHub connections and repositories.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Base64-encoded 32-byte key used to encrypt GitHub access tokens at rest.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional demo credentials. In production prefer LOGFOUND_DEMO_PASSWORD_HASH.
LOGFOUND_DEMO_USERNAME=founder
LOGFOUND_DEMO_PASSWORD=logfound-demo
LOGFOUND_DEMO_PASSWORD_HASH=
