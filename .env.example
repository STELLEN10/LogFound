# AI provider selected by the server-side provider registry: groq or openai.
AI_PROVIDER=groq
# Optional cross-provider model override. Leave blank to use GROQ_MODEL or OPENAI_MODEL.
AI_MODEL=
# Groq API key from console.groq.com. Server-only; never expose it to the browser.
GROQ_API_KEY=
# Groq chat-completions model.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional future provider key. Server-only; only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Optional OpenAI fallback model when AI_MODEL is blank.
OPENAI_MODEL=gpt-5.6

# Supabase public project URL. NEXT_PUBLIC_* is the existing browser-safe app convention.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key. Safe for the browser when protected by Supabase RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server aliases accepted by the app when you prefer non-public names for deployment configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase service-role key for server-only encrypted GitHub token storage. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build the GitHub OAuth callback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GitHub OAuth application credentials. Server-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte key (base64 or hex) used to encrypt GitHub tokens at rest. Server-only.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Reserved NextAuth-compatible settings for deployments that add a NextAuth adapter.
# Logfound's current authentication runtime uses Supabase sessions and does not require these yet.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Demo username/password authentication. Use a bcrypt hash in production instead of a plaintext password.
LOGFOUND_DEMO_USERNAME=founder
LOGFOUND_DEMO_PASSWORD=logfound-demo
# Optional bcrypt hash; when set it takes precedence over LOGFOUND_DEMO_PASSWORD.
LOGFOUND_DEMO_PASSWORD_HASH=
